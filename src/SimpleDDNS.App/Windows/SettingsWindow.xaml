<Window x:Class="SimpleDDNS.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}"
        Height="560"
        Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="StartWithWindowsCheckBox" Content="{DynamicResource Settings.Startup}" Margin="0,0,0,8" />
                <CheckBox x:Name="MinimizeToTrayCheckBox" Content="{DynamicResource Settings.MinimizeToTray}" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource Settings.DefaultInterval}" VerticalAlignment="Center" Width="140" />
                    <TextBox x:Name="DefaultIntervalTextBox" Width="120" />
                </StackPanel>

                <TextBlock Text="{DynamicResource Settings.Ipv4Endpoints}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="IPv4EndpointsTextBox" AcceptsReturn="True" Height="150" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

                <TextBlock Text="{DynamicResource Settings.Ipv6Endpoints}" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBox x:Name="IPv6EndpointsTextBox" AcceptsReturn="True" Height="150" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource Settings.LocalEndpointHint}" Foreground="#666666" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{DynamicResource Common.Cancel}" Width="90" Margin="0,0,8,0" Click="CancelButton_OnClick" />
            <Button Content="{DynamicResource Common.Save}" Width="90" Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
