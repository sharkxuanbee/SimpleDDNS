import { Button, ScrollView, Switch, HorizontalBox, VerticalBox, TextEdit, LineEdit, ComboBox, CheckBox, StandardButton } from "std-widgets.slint";

export struct ProfileData {
    id: string,
    name: string,
    domain: string,
    ipv4: string,
    ipv6: string,
    last_update: string,
    enabled: bool,
    status_message: string,
}

// A simple dialog overlay
component EditProfileDialog inherits Rectangle {
    in-out property <string> profile-id: ""; // Empty for new
    in-out property <string> p-name: "";
    in-out property <string> p-provider: "cloudflare"; // Default
    in-out property <string> p-domain: "";
    in-out property <string> p-subdomain: "";
    in-out property <string> p-key1: ""; // AccessKey / Token / Key
    in-out property <string> p-key2: ""; // Secret / User / Empty
    in-out property <bool> p-v4: true;
    in-out property <bool> p-v6: false;

    callback save(string, string, string, string, string, string, string, bool, bool);
    callback cancel();

    background: #00000080;
    
    TouchArea {
        // block clicks behind
    }

    Rectangle {
        width: 500px;
        height: 580px;
        background: white;
        border-radius: 8px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalBox {
            padding: 20px;
            spacing: 12px;

            Text {
                text: root.profile-id == "" ? "Add New Profile" : "Edit Profile";
                font-size: 18px;
                font-weight: 700;
            }

            HorizontalBox {
                Text { text: "Name:"; width: 100px; vertical-alignment: center; }
                LineEdit { text <=> root.p-name; placeholder-text: "My Website"; }
            }

            HorizontalBox {
                Text { text: "Provider:"; width: 100px; vertical-alignment: center; }
                ComboBox {
                    model: ["aliyun", "cloudflare", "dnspod", "godaddy", "namecheap", "generic"];
                    current-value <=> root.p-provider;
                }
            }

            HorizontalBox {
                Text { text: "Domain:"; width: 100px; vertical-alignment: center; }
                LineEdit { text <=> root.p-domain; placeholder-text: "example.com"; }
            }

            HorizontalBox {
                Text { text: "Subdomain:"; width: 100px; vertical-alignment: center; }
                LineEdit { text <=> root.p-subdomain; placeholder-text: "www (or @)"; }
            }

            // Dynamic Labels based on provider
            HorizontalBox {
                Text { 
                    text: root.p-provider == "aliyun" ? "AccessKey ID:" : 
                          root.p-provider == "dnspod" ? "ID:" :
                          root.p-provider == "godaddy" ? "Key:" :
                          root.p-provider == "namecheap" ? "API User:" :
                          "Token/Key:";
                    width: 100px; 
                    vertical-alignment: center; 
                }
                LineEdit { text <=> root.p-key1; placeholder-text: "Credential 1"; }
            }

            HorizontalBox {
                Text { 
                    text: root.p-provider == "aliyun" ? "AccessKey Secret:" : 
                          root.p-provider == "dnspod" ? "Token:" :
                          root.p-provider == "godaddy" ? "Secret:" :
                          root.p-provider == "namecheap" ? "API Key:" :
                          "Secret (Optional):";
                    width: 100px; 
                    vertical-alignment: center; 
                }
                LineEdit { 
                    text <=> root.p-key2; 
                    placeholder-text: "Credential 2"; 
                    input-type: password;
                }
            }

            HorizontalBox {
                spacing: 20px;
                CheckBox { text: "Enable IPv4"; checked <=> root.p-v4; }
                CheckBox { text: "Enable IPv6"; checked <=> root.p-v6; }
            }

            Rectangle { height: 10px; } // Spacer

            HorizontalBox {
                alignment: end;
                spacing: 12px;
                Button {
                    text: "Cancel";
                    clicked => { root.cancel(); }
                }
                Button {
                    text: "Save";
                    primary: true;
                    clicked => { 
                        root.save(root.profile-id, root.p-name, root.p-provider, root.p-domain, root.p-subdomain, root.p-key1, root.p-key2, root.p-v4, root.p-v6);
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "SimpleDDNS";
    width: 900px;
    height: 650px;
    background: #f0f2f5;

    in-out property <bool> global-running: true;
    in-out property <[ProfileData]> profiles: [];
    in-out property <string> logs-text: "";
    
    // Dialog State
    in-out property <bool> show-dialog: false;
    in-out property <string> d-id: "";
    in-out property <string> d-name: "";
    in-out property <string> d-provider: "cloudflare";
    in-out property <string> d-domain: "";
    in-out property <string> d-subdomain: "";
    in-out property <string> d-key1: "";
    in-out property <string> d-key2: "";
    in-out property <bool> d-v4: true;
    in-out property <bool> d-v6: false;

    callback toggle-global-running();
    callback toggle-profile(string, bool);
    callback trigger-update();
    callback delete-profile(string);
    
    // Save Profile (id, name, provider, domain, subdomain, key1, key2, v4, v6)
    // if id is empty, it's a create op.
    callback save-profile(string, string, string, string, string, string, string, bool, bool);
    
    // Request to fill dialog with profile data (for edit)
    callback edit-profile-request(string);

    VerticalBox {
        padding: 16px;
        spacing: 16px;

        // Top bar
        HorizontalBox {
            padding: 0px;
            alignment: space-between;
            height: 40px;
            
            Text {
                text: "SimpleDDNS";
                font-size: 24px;
                font-weight: 700;
                vertical-alignment: center;
                color: #333;
            }
            
            HorizontalBox {
                spacing: 12px;
                alignment: end;
                
                Button {
                    text: "Update Now";
                    height: 32px;
                    clicked => { root.trigger-update(); }
                }

                Rectangle {
                    width: 1px;
                    background: #ccc;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: center;
                    Text {
                        text: root.global-running ? "Running" : "Stopped";
                        vertical-alignment: center;
                        color: root.global-running ? #4caf50 : #9e9e9e;
                    }

                    Switch {
                        checked: root.global-running;
                        toggled => { root.toggle-global-running(); }
                    }
                }
            }
        }
        
        // Main list
        Rectangle {
            background: white;
            border-radius: 12px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000010;
            vertical-stretch: 1;
            
            VerticalBox {
                padding: 16px;
                spacing: 12px;
                
                HorizontalBox {
                    alignment: space-between;
                    Text {
                        text: "Profiles";
                        font-size: 18px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "+ Add Profile";
                        clicked => {
                            // Clear dialog
                            root.d-id = "";
                            root.d-name = "";
                            root.d-provider = "cloudflare";
                            root.d-domain = "";
                            root.d-subdomain = "";
                            root.d-key1 = "";
                            root.d-key2 = "";
                            root.d-v4 = true;
                            root.d-v6 = false;
                            root.show-dialog = true;
                        }
                    }
                }
                
                ScrollView {
                    VerticalBox {
                        spacing: 8px;
                        padding: 0px;
                        for profile in root.profiles : Rectangle {
                            background: #fafafa;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #e0e0e0;
                            height: 70px;
                            
                            HorizontalBox {
                                padding: 12px;
                                spacing: 12px;
                                alignment: center;
                                
                                Switch {
                                    checked: profile.enabled;
                                    toggled => { root.toggle-profile(profile.id, self.checked); }
                                }
                                
                                VerticalBox {
                                    padding: 0px;
                                    alignment: center;
                                    width: 150px;
                                    Text {
                                        text: profile.name;
                                        font-weight: 600;
                                        font-size: 14px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: profile.domain;
                                        font-size: 12px;
                                        color: #666;
                                        overflow: elide;
                                    }
                                }
                                
                                VerticalBox {
                                    padding: 0px;
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: "IPv4: " + (profile.ipv4 == "" ? "-" : profile.ipv4);
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "IPv6: " + (profile.ipv6 == "" ? "-" : profile.ipv6);
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                                
                                VerticalBox {
                                    padding: 0px;
                                    alignment: center;
                                    width: 140px;
                                    Text {
                                        text: "Last: " + (profile.last_update == "" ? "Never" : profile.last_update);
                                        font-size: 12px;
                                        color: #666;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: profile.status_message;
                                        font-size: 12px;
                                        color: profile.status_message == "OK" ? #4caf50 : #f44336;
                                        overflow: elide;
                                    }
                                }
                                
                                Button {
                                    text: "Edit";
                                    clicked => {
                                        root.edit-profile-request(profile.id);
                                    }
                                }
                                
                                Button {
                                    text: "Del";
                                    clicked => {
                                        root.delete-profile(profile.id);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        
        // Logs
        Rectangle {
            background: #1e1e1e;
            border-radius: 12px;
            height: 150px;
            clip: true;
            
            VerticalBox {
                padding: 12px;
                Text {
                    text: "Logs";
                    color: white;
                    font-weight: 600;
                    font-size: 14px;
                }
                TextEdit {
                    text: root.logs-text;
                    read-only: true;
                    font-size: 12px;
                    font-family: "Consolas";
                }
            }
        }
    }

    if root.show-dialog : EditProfileDialog {
        profile-id: root.d-id;
        p-name: root.d-name;
        p-provider: root.d-provider;
        p-domain: root.d-domain;
        p-subdomain: root.d-subdomain;
        p-key1: root.d-key1;
        p-key2: root.d-key2;
        p-v4: root.d-v4;
        p-v6: root.d-v6;

        save(id, name, provider, domain, subdomain, k1, k2, v4, v6) => {
            root.save-profile(id, name, provider, domain, subdomain, k1, k2, v4, v6);
            root.show-dialog = false;
        }
        cancel => {
            root.show-dialog = false;
        }
    }
}
